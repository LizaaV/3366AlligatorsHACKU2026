# Production backend settings for the AWS server.
# Copy to deploy/aws/.env.prod (git-ignored); ship.sh uploads it as backend/.env over SSH.
# Full list and meanings: backend/.env.example. Do not set EARTH_DATA_DIR or CORS_ORIGINS
# here; docker-compose sets them.

# real = live Sentinel-2 from Earth Search (us-west-2). stub = offline Hoo Hok Wai sample only.
EARTH_IMPL=real
SANDBOX_IMPL=subprocess

# Claude key for the agent. Without it only the scripted preset answers.
ANTHROPIC_API_KEY=
LLM_PROVIDER=claude
CLAUDE_MODEL=claude-opus-5-5
LLM_FALLBACKS=true
ALLOW_FAKE_PROVIDER=false

# agent = Claude tool-use loop; preset = scripted demo run with no AI calls (safe fallback).
AGENT_MODE=agent

# Spend and abuse limits for a public demo.
DAILY_SPEND_CAP_USD=20
RUN_COOLDOWN_S=3
RUNS_PER_HOUR_PER_USER=40
RUNS_PER_HOUR_PER_IP=60
SHARE_TTL_DAYS=30
