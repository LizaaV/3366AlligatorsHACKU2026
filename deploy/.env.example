# Deploy-level variables. Copy to deploy/.env (git-ignored) and run compose with:
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --build
# Backend settings (ANTHROPIC_API_KEY, EARTH_IMPL, SANDBOX_IMPL, ...) live in backend/.env;
# see backend/.env.example. Do not put secrets here.

# Public URL users open in the browser (no trailing slash). Added to CORS_ORIGINS.
PUBLIC_BASE_URL=http://localhost

# Host port for nginx. Use 80 on a VM; change if taken.
HTTP_PORT=80

# Frontend build arg (baked in at build time). http = real backend; fixture = scripted mocks only.
VITE_API_SOURCE=http
