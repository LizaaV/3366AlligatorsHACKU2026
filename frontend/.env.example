# Frontend configuration. Copy to .env.local for local overrides — .env* is git-ignored.
# Every variable must be prefixed VITE_ to be visible to the app (see src/vite-env.d.ts).

# Base path or origin for API calls. In dev, /api is proxied to the FastAPI server on :8000
# by vite.config.ts, so the default is usually right.
VITE_API_BASE_URL=/api

# Where endpoint data comes from:
#   http     the real FastAPI backend (default for running the app end to end). Start it with
#            `cd backend && uv run uvicorn app.main:app --reload`. Endpoints the backend does
#            not have (boundary detection, parcel lookup, file parsing, "ask your watches",
#            generic export) show "Not available yet" without making a request.
#   fixture  local stand-ins in src/api/fixtures/, no backend needed (offline UI work)
VITE_API_SOURCE=http

# Where the dev server proxies /api to. Default http://localhost:8000.
# VITE_PROXY_TARGET=http://localhost:8000

# Each browser gets a random user id (sent as X-User-Id, kept in localStorage), so visitors
# do not share history or the hourly run limit. A new id starts with no saved places. Pin it
# to `demo` to get the seeded Hoo Hok Wai example place (shared by everyone using `demo`).
# VITE_USER_ID=demo

# Fixture mode only: artificial delay on fixture responses, so loading states are exercised in development.
VITE_FIXTURE_LATENCY_MS=500

# Fraction of fixture requests that fail, for checking error and retry states. 0 disables.
VITE_FIXTURE_ERROR_RATE=0

# Make the synthesised fixture run pause and ask a clarifying question, so the clarification
# card and the /reply flow can be exercised offline. The stub backend never asks one
# (docs/API.md §4) and the real flow arrives with the agent loop in module A3.
VITE_FIXTURE_CLARIFY=0

# Basemap tiles. Tokens: {z} {x} {y}. Defaults to EOX Sentinel-2 cloudless.
# VITE_TILE_URL_TEMPLATE=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg
