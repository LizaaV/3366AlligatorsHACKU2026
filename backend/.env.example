# Copy to .env and fill in. .env is git-ignored — never commit real keys.
CORS_ORIGINS=["http://localhost:5173"]

# earth: stub (Hoo Hok Wai preset, no network) | real
EARTH_IMPL=stub
# Optional: where cache, rendered layers and memory live (default backend/data, git-ignored)
# EARTH_DATA_DIR=

# Sandbox for agent-written scripts: subprocess (default) | docker (opt-in, see deploy/README.md)
SANDBOX_IMPL=subprocess

# earth context providers (Nominatim, Planetary Computer, Open-Meteo): all free, no keys.
# Network tests: EARTH_NETWORK_TESTS=1 EARTH_IMPL=real uv run pytest tests/test_earth_context.py

# Share links (M6): frontend origin used in share URLs, and how long a link lives
PUBLIC_BASE_URL=http://localhost:5173
# SHARE_TTL_DAYS must be an integer from 1 to 3650 (the app refuses to start otherwise)
SHARE_TTL_DAYS=30

# NASA FIRMS active fire for earth.fires() (M9c). Optional, SERVER ONLY: never in the sandbox or
# frontend. Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/ . Without it fires() says so.
# FIRMS_MAP_KEY=
# Docker sandbox (only read when SANDBOX_IMPL=docker). Local setup: sh sandbox/dev-up.sh
# SANDBOX_IMAGE=earth-sandbox:latest
# SANDBOX_NETWORK=earth-only
# Earth service: where the backend binds it, and its URL as seen from inside the sandbox
# EARTH_SERVICE_HOST=127.0.0.1
# EARTH_SERVICE_PORT=8701
# EARTH_SERVICE_URL=http://earth-relay:8701

# --- Agent loop (A3) ---
# Required for the agent (server only; never sent to the sandbox). Get one at
# https://console.anthropic.com. Leave unset to run without the agent (presets only).
ANTHROPIC_API_KEY=
# LLM provider for agent runs: claude ("fake" is for tests only, needs ALLOW_FAKE_PROVIDER=true)
LLM_PROVIDER=claude
# Claude model id (exact id, no date suffix)
CLAUDE_MODEL=claude-opus-5-5
# Server-side refusal fallback for Claude (beta); retried once without it if rejected
LLM_FALLBACKS=true
# Scripted fake LLM: tests only, never in production
ALLOW_FAKE_PROVIDER=false
# agent = tool-use loop | preset = scripted Hoo Hok Wai demo run (no LLM)
AGENT_MODE=agent
# Spend (USD) across all runs in the last 24 h above which new agent runs are refused
DAILY_SPEND_CAP_USD=20
# Minimum seconds between two runs started by the same user
RUN_COOLDOWN_S=3
# Loop limits: model turns, run_code + run_skill calls, wall clock (s) per run
AGENT_MAX_TURNS=12
AGENT_MAX_CODE_RUNS=6
AGENT_WALL_CLOCK_S=150
# max_tokens per agent turn (incl. adaptive thinking) and for the guard call
AGENT_TURN_MAX_TOKENS=16000
GUARD_MAX_TOKENS=4000
